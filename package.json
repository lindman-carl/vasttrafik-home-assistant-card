{
  "name": "vasttrafik-home-assistant-card",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@12.16.1",
  "description": "A Home Assistant card showing Västtrafik departures",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "hacs",
    "custom-cards",
    "vasttrafik",
    "transport",
    "schedule",
    "commute"
  ],
  "module": "dist/vasttrafik-home-assistant-card.js",
  "repository": "git@github.com:lindman-carl/vasttrafik-home-assistant-card.git",
  "author": "Carl Lindman",
  "license": "MIT",
  "dependencies": {
    "custom-card-helpers": "^2.0.0",
    "date-fns": "^4.4.0",
    "lit": "^3.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "rollup": "^4.68.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-serve": "^3.0.0",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "rollup -c rollup.config.dev.js --watch",
    "build": "pnpm clean && pnpm check && pnpm typecheck && pnpm rollup",
    "clean": "rm -rf dist",
    "check": "biome check src tests vitest.config.ts playwright.config.ts",
    "check:write": "biome check --write src tests vitest.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node --test tests/integration/runner.test.mjs && node tests/integration/run.mjs",
    "typecheck": "tsc --noEmit",
    "rollup": "rollup -c"
  }
}
